#include "SPI.h"

static void led_init(void);
static void led_on(void);
static void led_off(void);

int main(void)
{
    // 1. Initialize Slave first so it is ready for the clock
    spi2_gpio_config();
    spi2_config();

    // 2. Initialize Master
    spi1_gpio_config();
    spi1_config();

    led_init(); // Initialize PA9 for LED

    uint8_t spi1_tx_data[3] = {0x77, 0x88, 0x99};
    uint8_t spi2_rx_data[3];
    uint8_t spi1_rx_data[3]; // Dummy/Returned data

    cs_enable();

    for(uint8_t i = 0; i < 3; i++)
    {
        // Master Transmit
        while(!(SPI1->SR & SPI_SR_TXE));
        SPI1->DR = spi1_tx_data[i];

        // Slave Receive
        while(!(SPI2->SR & SPI_SR_RXNE));
        spi2_rx_data[i] = SPI2->DR;

        // Master Receive (data shifted back from slave)
        while(!(SPI1->SR & SPI_SR_RXNE));
        spi1_rx_data[i] = SPI1->DR;
    }

    while(SPI1->SR & SPI_SR_BSY);
    cs_disable();

    // Clear OVR flags
    volatile uint8_t temp;
    temp = SPI1->DR; temp = SPI1->SR;
    temp = SPI2->DR; temp = SPI2->SR;

    while(1)
    {
        uint8_t success = 1;
        for(uint8_t i = 0; i < 3; i++)
        {
            if(spi2_rx_data[i] != spi1_tx_data[i])
            {
                success = 0;
                break;
            }
        }

        if(success)
        {
        	led_on();
        }
        else
        {
        	led_off();
        }

        for(volatile uint32_t i = 0; i < 500000; i++); // Visible delay
    }
}

static void led_init(void)
{
    RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN;
    GPIOA->MODER &= ~(3U << 18); // Clear bits for PA9
    GPIOA->MODER |=  (1U << 18); // Set PA9 as Output
}

static void led_on(void)
{
	GPIOA->ODR |= (1U << 9);
}
static void led_off(void)
{
	GPIOA->ODR &= ~(1U << 9);
}
