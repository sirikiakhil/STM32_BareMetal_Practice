

#include "stm32f4xx.h"

#define BAUDRATE     100U
#define CLOCK_FREQ   16000000U  //MCU Clock Speed(16MHz)

void uart_config(void);
static uint32_t Baudrate_config(uint32_t Clk_freq,uint32_t Baudrate);
void gpio_config();
void ADC_config();
void Uart_tx(uint16_t value);

int main(void)
{
	gpio_config();
	ADC_config();
	uart_config();
	uint16_t value;
	while(1)
	{

		while(!(ADC1->SR & 2U)){}
			value = ADC1->DR;

		Uart_tx(value);
	}
}

void gpio_config()
{
	RCC->AHB1ENR |= (RCC_AHB1ENR_GPIOAEN);
	(void)RCC->AHB1ENR;

	GPIOA->MODER &= ~(3U << 0);
	GPIOA->MODER |= (3U << 0);

	GPIOA->PUPDR &= ~(3U << 0);
}

void ADC_config()
{
	RCC->APB2ENR |= (RCC_APB2ENR_ADC1EN);
	(void)RCC->APB2ENR;

	ADC1->CR2 &= ~(1U);

	//Configure ADC Common Settings
	ADC->CCR &= ~(0x1F);
    ADC->CCR &= ~(3U << 16);

	//ADC Basic Configuration (ADC1)
	ADC1->CR1 &= ~(1U << 8);

	ADC1->CR1 &= ~(3U << 24);

	ADC1->CR2 |= (1U << 1);

	ADC1->CR2 &= ~(1U << 11);

	ADC1->SMPR2 |= (7U);

	ADC1->SQR1 &= ~(15U << 20);

	ADC1->SQR3 &= ~(0x1F << 0);
	ADC1->SQR3 |=  (0 << 0);

	ADC1->CR2 |= (1 << 0);

	ADC1->CR2 |= (1U <<30);
}




void uart_config(void)
{
	//Enable clock for PORTA
	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN;
	(void)RCC->AHB1ENR;

	//config PORTA Pin2 mode as Alternative function
	GPIOA->MODER &= ~(3U << 4);
	GPIOA->MODER |= (2U << 4);

	//Config AFRL
	GPIOA->AFR[0] &= ~(0xFU << 8);   // clear bits 11:8
	GPIOA->AFR[0] |=  (7U << 8);     // AF7 = USART2_TX


	//Enable clock for UART2
	RCC->APB1ENR |= RCC_APB1ENR_USART2EN;
	(void)RCC->APB1ENR;


	USART2->CR1 &= ~USART_CR1_UE;  //disabled uart to configure

	USART2->BRR = Baudrate_config(CLOCK_FREQ,BAUDRATE); //UART does not store baud rate directly , insted it stores a divider value
    //Divider = (clock / Baudrate)

	USART2->CR1 |= USART_CR1_TE;  // TE

	USART2->CR1 |= USART_CR1_UE;    //Enable the UART2
}

static uint32_t Baudrate_config(uint32_t Clk_freq,uint32_t Baudrate)
{
	return ((Clk_freq + (Baudrate/2))/Baudrate); //this formula is used to rounding the integer division value
}

void Uart_tx(uint16_t value)
{
	uint8_t byte[50];
	sprintf(byte, "%d\r\n", value);

	//byte[0] = (value >> 8);
	//byte[1] = (value & 0xFF);
	for(uint8_t i =0; byte[i] != '/0';i++)
	{
		while(!(USART2->SR & USART_SR_TXE)){}

				USART2->DR = byte[i];
	}

}


