
#ifndef INC_I2C_H_
#define INC_I2C_H_

#include "stm32f4xx.h"   // Device header for register definitions

/* Function to initialize I2C1 peripheral (GPIO setup + I2C configuration) */
void I2C1_Init(void);

/* Read a single byte from a slave device */
void I2C_ByteRead(char saddr, char reg_addr, char* data );

/* Read multiple bytes continuously from a slave */
void I2C1_BurstRead(char saddr, char reg_addr, int n, char* data);

/* Write multiple bytes continuously to a slave */
void I2C1_BurstWrite(char saddr, char reg_addr, int n, char* data);

#endif /* INC_I2C_H_ */
