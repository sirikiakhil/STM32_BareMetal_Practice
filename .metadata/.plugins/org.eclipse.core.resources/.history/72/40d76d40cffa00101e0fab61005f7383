#include "I2C.h"

#define I2C_stand_mode 80   // CCR value for 100kHz I2C in standard mode
#define RISE_TIME      17   // Maximum rise time value for standard mode

void I2C1_Init(void)
{
    // Enable clock for GPIOB (I2C1 pins are on Port B)
    RCC->AHB1ENR |= (RCC_AHB1ENR_GPIOBEN);
    (void)RCC->AHB1ENR;   // Dummy read to ensure clock is stable

    // Set PB8 and PB9 as Alternate Function mode
    GPIOB->MODER |=  (1U<<17);
    GPIOB->MODER &= ~(1U<<16);
    GPIOB->MODER |=  (1U<<19);
    GPIOB->MODER &= ~(1U<<18);

    // Select AF4 (I2C) for PB8
    GPIOB->AFR[1] &= ~(1U<<0);
    GPIOB->AFR[1] &= ~(1U<<1);
    GPIOB->AFR[1] |=  (1U<<2);
    GPIOB->AFR[1] &= ~(1U<<3);

    // Select AF4 (I2C) for PB9
    GPIOB->AFR[1] &= ~(1U<<4);
    GPIOB->AFR[1] &= ~(1U<<5);
    GPIOB->AFR[1] &= ~(1U<<6);
    GPIOB->AFR[1] &= ~(1U<<7);

    // Set PB8 and PB9 as Open Drain (required for I2C lines)
    GPIOB->OTYPER |= (1U <<8);
    GPIOB->OTYPER |= (1U <<9);

    // Enable internal pull-up resistors for SDA and SCL
    GPIOB->PUPDR &= ~(1U<<17);
    GPIOB->PUPDR &= ~(1U<<19);
    GPIOB->PUPDR |=  (1U<<16);
    GPIOB->PUPDR |=  (1U<<18);

    // Enable clock for I2C1 peripheral
    RCC->APB1ENR |= (RCC_APB1ENR_I2C1EN);

    // Put I2C in software reset mode before configuration
    I2C1->CR1 |= (I2C_CR1_SWRST);

    // Release I2C from reset
    I2C1->CR1 &= ~(I2C_CR1_SWRST);

    // Set APB1 clock frequency (16 MHz)
    I2C1->CR2 = (1U << 4);

    // Set clock control register for 100kHz
    I2C1->CCR = I2C_stand_mode;

    // Set maximum rise time
    I2C1->TRISE = RISE_TIME;

    // Enable I2C peripheral
    I2C1->CR1 |= (I2C_CR1_PE);
}


// Read single byte from a slave device register
void I2C_ByteRead(char slave_addr, char reg_addr, char* data )
{
	volatile int temp;  // Used to clear flags

	// Wait until I2C bus is free
	while(I2C1->SR2 & (I2C_SR2_BUSY)){}

	// Generate START condition
	I2C1->CR1 |= (I2C_CR1_START);

	// Wait until START condition sent
	while(!(I2C1->SR1 & (I2C_SR1_SB))){}

	// Send slave address with write bit (to send register address first)
	I2C1->DR = slave_addr << 1;

	// Wait for address to be acknowledged
	while(!(I2C1->SR1 & (I2C_SR1_ADDR))){}

	// Clear ADDR flag by reading SR2
	temp = I2C1->SR2;

	// Send internal register address of slave
	I2C1->DR = reg_addr;

	// Wait until data register empty
	while(!(I2C1->SR1 & I2C_SR1_TXE)){}

	// Generate Re-START for read operation
	I2C1->CR1 |= (I2C_CR1_START);

	// Wait for START flag again
	while(!(I2C1->SR1 & (I2C_SR1_SB))){}

	// Send slave address with read bit
	I2C1->DR = slave_addr << 1 | 1;

	// Wait for address acknowledgement
	while(!(I2C1->SR1 & (I2C_SR1_ADDR))){}

	// Disable ACK because only one byte is received
	I2C1->CR1 &= ~(I2C_CR1_ACK);

	// Clear ADDR flag
	temp = I2C1->SR2;

	// Generate STOP condition
	I2C1->CR1 |= (I2C_CR1_STOP);

	// Wait until data is received
	while(!(I2C1->SR1 & (I2C_SR1_RXNE))){}

	// Store received byte
	*data++ = I2C1->DR;
}


// Read multiple bytes from slave
void I2C1_BurstRead(char slave_addr, char reg_addr, int n, char* data)
{
	volatile int temp;

	// Wait until bus is free
	while(I2C1->SR2 & (I2C_SR2_BUSY)){}

	// Send START
	I2C1->CR1 |= (I2C_CR1_START);

	// Wait for START confirmation
	while(!(I2C1->SR1 & (I2C_SR1_SB))){}

	// Send slave address in write mode
	I2C1->DR = slave_addr << 1;

	// Wait for address phase completion
	while(!(I2C1->SR1 & (I2C_SR1_ADDR))){}

	// Clear ADDR flag
	temp = I2C1->SR2;

	// Wait until DR empty
	while(!(I2C1->SR1 & (I2C_SR1_TXE))){}

	// Send internal register address
	I2C1->DR = reg_addr;

	// Wait again until DR empty
	while(!(I2C1->SR1 & (I2C_SR1_TXE))){}

	// Generate Re-START
	I2C1->CR1 |= (I2C_CR1_START);

	// Wait for START
	while(!(I2C1->SR1 & (I2C_SR1_SB))){}

	// Send slave address in read mode
	I2C1->DR = slave_addr << 1 | 1;

	// Wait for address phase
	while(!(I2C1->SR1 & (I2C_SR1_ADDR))){}

	// Clear ADDR flag
	temp = I2C1->SR2;

	// Enable ACK for multiple bytes
	I2C1->CR1 |= (I2C_CR1_ACK);

	while(n>0U)
	{
		// If last byte
		if(n == 1)
		{
			// Disable ACK before last byte
			I2C1->CR1 &= ~(I2C_CR1_ACK);

			// Generate STOP
			I2C1->CR1 |= (I2C_CR1_STOP);

			// Wait until data arrives
			while(!(I2C1->SR1 & (I2C_SR1_RXNE))){}

			// Store last byte
			*data++ = I2C1->DR;

			break;
		}
		else
		{
			// Wait for data ready
			while(!(I2C1->SR1 & (I2C_SR1_RXNE))){}

			// Read byte
			(*data++) = I2C1->DR;

			n--;
		}
	}
}


// Write multiple bytes to slave
void I2C1_BurstWrite(char slave_addr, char reg_addr, int n, char* data)
{
	volatile int temp;

	// Wait until bus is idle
	while(I2C1->SR2 & I2C_SR2_BUSY) {}

	// Generate START
	I2C1->CR1 |= (I2C_CR1_START);

	// Wait for START confirmation
	while(!(I2C1->SR1 & (I2C_SR1_SB))){}

	// Send slave address with write bit
	I2C1->DR = slave_addr << 1;

	// Wait for address acknowledgement
	while(!(I2C1->SR1 & (I2C_SR1_ADDR))){}

	// Clear ADDR flag
	temp = I2C1->SR2;

	// Wait until DR empty
	while(!(I2C1->SR1 & (I2C_SR1_TXE))){}

	// Send internal register address
	I2C1->DR = reg_addr;

	for(int i=0; i<n; i++)
	{
		// Wait until DR ready
		while(!(I2C1->SR1 & (I2C_SR1_TXE))){}

		// Send each data byte
		I2C1->DR = *data++;
	}

	// Wait until transfer finishes
	while(!(I2C1->SR1 & (I2C_SR1_BTF))){}

	// Generate STOP condition
	I2C1->CR1 |= (I2C_CR1_STOP);
}




